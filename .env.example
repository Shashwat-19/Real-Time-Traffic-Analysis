# Copy to .env and fill in. Never commit .env.
TOMTOM_API_KEY=your_tomtom_api_key_here
# Comma-separated name:latitude:longitude entries (defaults are used when unset)
LOCATIONS=New Delhi:28.6139:77.2090,Mumbai:19.0760:72.8777,Bengaluru:12.9716:77.5946
FETCH_INTERVAL_MINUTES=10
RAW_DATA_PATH=data/raw/traffic_data.csv
PROCESSED_DATA_PATH=data/processed/traffic_features.csv
MODEL_PATH=models/traffic_model.pkl
METRICS_PATH=outputs/metrics/model_metrics.json
